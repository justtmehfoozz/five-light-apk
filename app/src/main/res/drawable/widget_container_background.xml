<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- LAYER 1: Ambient Drop Shadow / Soft Floating Separation from Wallpaper -->
    <item
        android:top="2dp"
        android:left="1dp"
        android:right="1dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/widget_glass_ambient_shadow" />
        </shape>
    </item>

    <!-- LAYER 2: Translucent Dock Glass Substrate (Smoky Obsidian / Warm Milk Glass) -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <solid android:color="@color/widget_glass_base" />
        </shape>
    </item>

    <!-- LAYER 3: Frosted Diffusion & Light-Scattering Sheen (Softens & diffuses wallpaper behind) -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/widget_glass_diffusion_top"
                android:centerColor="@color/widget_glass_diffusion_mid"
                android:centerY="0.5"
                android:endColor="@color/widget_glass_diffusion_bottom" />
        </shape>
    </item>

    <!-- LAYER 4: Curved Lens Refraction (Subtle Celestial Amber Glow at Top Center) -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:type="radial"
                android:gradientRadius="240dp"
                android:centerX="0.5"
                android:centerY="0.0"
                android:startColor="@color/widget_glass_refraction_center"
                android:endColor="@color/widget_glass_refraction_edge" />
        </shape>
    </item>

    <!-- LAYER 5: Specular Light Reflection (Dock Signature Top Arc Sheen) -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="@color/widget_glass_specular_start"
                android:centerColor="@color/widget_glass_specular_mid"
                android:centerY="0.25"
                android:endColor="#00FFFFFF" />
        </shape>
    </item>

    <!-- LAYER 6: Soft Glass Boundary (Gentle Specular Hairline Rim, No Thick Borders) -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="24dp" />
            <stroke
                android:width="1dp"
                android:color="@color/widget_glass_border" />
        </shape>
    </item>

</layer-list>
