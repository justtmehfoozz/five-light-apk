rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User data is strictly private to the authenticated owner.
    // Unauthenticated users cannot read or write any user data.
    // Authenticated users can only read and write documents inside their own /users/{userId} path.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{allSubcollections=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
